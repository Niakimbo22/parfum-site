# --- Supabase ---
# Public URL of your Supabase project (safe to ship to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to ship to the browser; only allows what RLS permits).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. NEVER expose to the browser. Used by server actions only.
# Keep out of NEXT_PUBLIC_* and never log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin authentication ---
# bcrypt hashes of each admin's password. Generate with:
#   node -e "console.log(require('bcrypt').hashSync('your-password', 12))"
ADMIN_HASH_NICO=
ADMIN_HASH_LUCA=

# JWT signing key for the admin session cookie.
# Required. Must be at least 32 characters of high-entropy random.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=
